<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Review round 2 (item 12): tests for the app layer (src/PoolWatch), which PoolWatch.Tests (Core only) cannot reach.
    Windows only (net10.0-windows, x64 like the app). Nothing here may change a real service, scheduled task, registry
    value or file ACL, or end a real process: the app code under test takes its system access through injected fakes,
    and file-system tests work only inside the test's own TEMP folders.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PoolWatch\PoolWatch.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
