<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the app layer (src/PoolWatch), which PoolWatch.Tests (Core only) cannot reach.
    Windows only (net10.0-windows, x64 like the app). Nothing here may change a real service, scheduled task, registry
    value or file ACL, or end a real process: the app code under test takes its system access through injected fakes,
    and file-system tests work only inside the test's own TEMP folders.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PoolWatch\PoolWatch.csproj" />
    <!-- The launcher, built normally (with the JIT) for its tests; it ships compiled ahead of time (ci.yml). Under an alias:
         it compiles in the program's own Engine/AdminFolderRules.cs, whose types would otherwise be in both. -->
    <ProjectReference Include="..\..\src\PoolWatch.Launcher\PoolWatch.Launcher.csproj" Aliases="launcher" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
