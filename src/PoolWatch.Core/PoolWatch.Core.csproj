<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PoolWatch.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PoolWatch.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services\services-catalogue.json" LogicalName="services-catalogue.json" />
    <!-- The known-issue packs (docs/knowledge-packs.md); the schema is for editors and the tests, not the app. -->
    <EmbeddedResource Include="..\..\knowledge\*.json" Exclude="..\..\knowledge\schema.json" LogicalName="knowledge/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
