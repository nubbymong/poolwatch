<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PoolWatch</AssemblyName>
    <RootNamespace>PoolWatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\poolwatch.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Single-file publish (`dotnet publish -p:PublishSingleFile=true`): no self-extraction. With
         IncludeNativeLibrariesForSelfExtract the host extracted the native DLLs (TraceEvent's KernelTraceControl / msdia,
         the runtime's own) into the user's %TEMP% and the elevated process loaded them from there, a folder any program
         of the user can write. They now ship next to PoolWatch.exe, in the admin-only install folder
         (%ProgramFiles%\PoolWatch): the release is a folder (zip), not one file. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!-- Memory: workstation GC without the background-GC thread, and a heap that is compacted harder (an early build reached 342 MB on a busy PC). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- No start-up hooks (System.StartupHookProvider.IsSupported false in the runtimeconfig, which the single-file build
         carries inside the exe): the runtime ignores DOTNET_STARTUP_HOOKS even in a PoolWatch.exe started without its
         launcher, which gives PoolWatch an environment without it anyway (Engine/LaunchGate.cs). -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- Gen0 at most 8 MB, whatever the CPU. The workstation GC sizes gen0 from the CPU's largest cache (about half of it,
         up to 80 MB) and, without the background GC, lets it grow to 128 MB. At PoolWatch's 9 MB a minute a CI runner with
         a large cache made no collection of gen0 alone in 45 minutes (gen0/1/2 10/10/10: every one was full): the GC kept
         59 MB committed instead of 34, and the working set reached 113 MB against the 100 MB budget (85 and 87 MB in two
         runs the day before, same code). 8 MB is two of the GC's 4 MB regions: about 65 gen0 collections an hour, about
         1 ms each. It is set here, not in the environment (DOTNET_GCGen0MaxBudget; DOTNET_GCgen0size has no runtimeconfig
         name), because the launcher gives PoolWatch a clean environment; the runtime reads System.GC.Gen0MaxBudget from
         the runtimeconfig since .NET 10 (9.0 had no public name for it). The soak prints the cap the GC runs with. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="8388608" />
  </ItemGroup>
  <ItemGroup>
    <!-- The guide for a user's AI assistant (Engine/AgentsGuide.cs): written into the data folder and every export. -->
    <EmbeddedResource Include="Assets\AGENTS.md" LogicalName="AGENTS.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tray and window icons (Ui/TrayIcons.cs), named one by one so a missing file fails the build: the binoculars
         with a dot in each state's colour for the tray, and the plain binoculars (the program's icon) for the windows. -->
    <EmbeddedResource Include="Assets\poolwatch.ico" LogicalName="poolwatch.ico" />
    <EmbeddedResource Include="Assets\tray-healthy.ico" LogicalName="tray-healthy.ico" />
    <EmbeddedResource Include="Assets\tray-warning.ico" LogicalName="tray-warning.ico" />
    <EmbeddedResource Include="Assets\tray-critical.ico" LogicalName="tray-critical.ico" />
    <EmbeddedResource Include="Assets\tray-inactive.ico" LogicalName="tray-inactive.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PoolWatch.Core\PoolWatch.Core.csproj" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <!-- The Clear cache helper (PoolWatch.CacheHelper, run by two SYSTEM tasks) is gone: the purge is in-process, and
         nothing is written into Program Files. -->
  </ItemGroup>
  <!-- Off Windows (CI's Linux compile check), restore prunes System.CodeDom as it does on Windows, so packages.lock.json,
       made on Windows, holds there too and that restore runs in locked mode. System.CodeDom is a System.Management
       dependency that the Windows Desktop runtime provides. On Windows the SDK reads that from the Windows Desktop
       targeting pack, which lists it at the pack's version (10.0.14), and prunes it at any patch of that version's
       major.minor (up to 10.0.32767), which is the target framework's major.minor: the target computes the same version
       from the target framework. An SDK off Windows has no such pack, and its fallback list is .NET 9's, which prunes
       System.CodeDom 9.0.x only, so the graph gained System.CodeDom 10.0.x. That list prunes every other Windows Desktop
       package (System.Diagnostics.EventLog, System.Drawing.Common and the rest) only up to 9.0.x too, and leaves out
       System.Formats.Nrbf; System.CodeDom is the only one in this graph. If the Linux job's locked restore fails on
       another one, prune it here the same way. The compile references are the same either way: they come from the
       Windows Desktop targeting pack, which restore downloads off Windows. -->
  <Target Name="PruneSystemCodeDomAsOnWindows" AfterTargets="AddPrunePackageReferences" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <PrunePackageReference Remove="System.CodeDom" />
      <PrunePackageReference Include="System.CodeDom" Version="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2)).32767" />
    </ItemGroup>
  </Target>
</Project>
