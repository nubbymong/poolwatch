<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PoolWatch</AssemblyName>
    <RootNamespace>PoolWatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Single-file publish (`dotnet publish -p:PublishSingleFile=true`). S4 (review round 2): no self-extraction. With
         IncludeNativeLibrariesForSelfExtract the host extracted the native DLLs (TraceEvent's KernelTraceControl / msdia,
         the runtime's own) into the user's %TEMP% and the elevated process loaded them from there, a folder any program
         of the user can write. They now ship next to PoolWatch.exe, in the admin-only install folder
         (%ProgramFiles%\PoolWatch): the release is a folder (zip), not one file. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!-- Memory: workstation GC without the background-GC thread, and a heap that is compacted harder (an early build reached 342 MB on a busy PC). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <!-- The guide for a user's AI assistant (Engine/AgentsGuide.cs): written into the data folder and every export. -->
    <EmbeddedResource Include="Assets\AGENTS.md" LogicalName="AGENTS.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PoolWatch.Core\PoolWatch.Core.csproj" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.30" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- S5 (review round 2): the Clear cache helper (PoolWatch.CacheHelper, run by two SYSTEM tasks) is gone; the purge is
         in-process. Nothing is embedded or written into Program Files any more. -->
  </ItemGroup>
</Project>
