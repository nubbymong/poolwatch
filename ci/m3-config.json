{
  // Scenario 4: the M2 CI thresholds plus a confirmation trace on the first alert.
  "sampleIntervalSeconds": 2,
  "handleIntervalSeconds": 10,
  "tagCsvIntervalSeconds": 10,
  "processCsvIntervalSeconds": 10,
  "growthRules": [ { "windowMinutes": 1, "bytes": 3145728 } ],
  "releaseBytes": 2097152,
  "releaseWindowMinutes": 1,
  "retentionMinutes": 0.5,
  "incidentQuietMinutes": 0.5,
  "incidentMaxMinutes": 10,
  "growingDisplayBytesPer10Min": 1048576,
  "captureOnAlert": true,
  "captureSeconds": 25,
  // At most one automatic capture per interval (default 60 min). 1 min (the floor) so the leak's incident is still
  // traced when unrelated growth on the runner took the first trace (its capture is held back, then started).
  "autoCaptureMinMinutes": 1,
  // An automatic (on-alert) capture records pool events only unless deeperCapture is on. On here so the trace also
  // records Kernel-File and the scenario keeps testing the file-activity attribution (the opens Leaker.exe makes).
  "deeperCapture": true,
  // CI never asks GitHub for a new version (shared runner addresses; the numbers stay comparable).
  "checkForUpdates": false
}
