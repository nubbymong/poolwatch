<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <Version>1.1.0</Version>
    <Company>PoolWatch</Company>
    <Product>PoolWatch</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- L3 (supply chain): every project's package graph, transitive packages included, is pinned with its content hash in
         packages.lock.json. CI (CI=true) restores in locked mode: a changed, added or substituted package fails the build
         instead of being used. After changing a package reference, run `dotnet restore -force-evaluate` and commit the
         lock files. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- So a plain restore and the release's `dotnet publish -r win-x64 -p:PublishSingleFile=true` (whose properties flow to
         every referenced project) lock the same graph: every project also restores for win-x64, and the single-file
         analyzer is off. That analyzer comes in an implicit Microsoft.NET.ILLink.Tasks package whose version follows the
         SDK patch, so it would break the locked restore on every SDK update; PoolWatch never uses Assembly.Location or
         other single-file-unsafe APIs (it uses AppContext.BaseDirectory and Environment.ProcessPath). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>
</Project>
